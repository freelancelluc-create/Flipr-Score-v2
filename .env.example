# Copia este archivo a .env.local y rellena lo que tengas.

# IA (una de las dos). Sin clave, usa `npm run dev:mock` para ver la app con datos de ejemplo.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vercel KV / Upstash (opcional en local: sin esto no se guardan métricas ni hay rate limit)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Token para consultar /api/stats (pon uno largo y aleatorio)
ADMIN_TOKEN=
